<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Flow.Launcher.Plugin.easyssh</AssemblyName>
    <RootNamespace>Flow.Launcher.Plugin.EasySsh</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>3.0.0</Version>
    <Authors>Melv1no</Authors>
    <PackageId>Flow.Launcher.Plugin.easyssh</PackageId>
    <PackageProjectUrl>https://github.com/Melv1no/Flow.Launcher.Plugin.easyssh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Melv1no/Flow.Launcher.Plugin.easyssh</RepositoryUrl>
    <PackageTags>flow-launcher flow-plugin ssh</PackageTags>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Embedded symbols give line numbers in Flow Launcher's logs when something goes wrong. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flow Launcher ships Flow.Launcher.Plugin itself: compile against it, never copy it.
         5.0.0 is the API of Flow Launcher 2.0.0, the MinimumAppVersion declared in plugin.json:
         compiling against it guarantees that no newer API is used by mistake. -->
    <PackageReference Include="Flow.Launcher.Plugin" Version="5.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language files are loaded by Flow Launcher at runtime: they must stay loose XAML, not compiled pages. -->
    <Page Remove="Languages\*.xaml" />
    <Content Include="Languages\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flow.Launcher.Plugin.easyssh.Tests" />
  </ItemGroup>

</Project>
