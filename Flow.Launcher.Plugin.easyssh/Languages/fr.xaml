<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Plugin -->
    <system:String x:Key="plugin_easyssh_plugin_name">EasySSH</system:String>
    <system:String x:Key="plugin_easyssh_plugin_description">Enregistrez, recherchez et ouvrez vos connexions SSH dans votre terminal préféré.</system:String>

    <!-- Recherche -->
    <system:String x:Key="plugin_easyssh_no_match_title">Aucune connexion ne correspond à « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_no_match_subtitle">Vérifiez l'orthographe, ou ajoutez un profil avec « add »</system:String>
    <system:String x:Key="plugin_easyssh_config_host_subtitle">Depuis ~/.ssh/config · {0}</system:String>
    <system:String x:Key="plugin_easyssh_direct_title">Se connecter à {0}</system:String>
    <system:String x:Key="plugin_easyssh_direct_subtitle">Connexion ponctuelle : {0} · dans {1}</system:String>
    <system:String x:Key="plugin_easyssh_empty_title">Aucune connexion enregistrée</system:String>
    <system:String x:Key="plugin_easyssh_empty_subtitle">Appuyez sur Entrée, puis tapez : add &lt;nom&gt; &lt;utilisateur@hôte&gt;</system:String>
    <system:String x:Key="plugin_easyssh_shortcut_terminal_title">Terminal : {0}</system:String>
    <system:String x:Key="plugin_easyssh_shortcut_terminal_subtitle">Choisir le terminal qui ouvre les connexions</system:String>

    <!-- Commandes -->
    <system:String x:Key="plugin_easyssh_cmd_add_title">Ajouter un profil</system:String>
    <system:String x:Key="plugin_easyssh_cmd_add_subtitle">add &lt;nom&gt; &lt;utilisateur@hôte ou commande ssh&gt;</system:String>
    <system:String x:Key="plugin_easyssh_cmd_edit_title">Modifier un profil</system:String>
    <system:String x:Key="plugin_easyssh_cmd_edit_subtitle">edit &lt;recherche&gt; · le profil s'ouvre dans la barre de recherche, modifiez-le et appuyez sur Entrée</system:String>
    <system:String x:Key="plugin_easyssh_cmd_remove_title">Supprimer un profil</system:String>
    <system:String x:Key="plugin_easyssh_cmd_remove_subtitle">remove &lt;recherche&gt; · une confirmation est demandée</system:String>
    <system:String x:Key="plugin_easyssh_cmd_profiles_title">Rechercher dans vos connexions</system:String>
    <system:String x:Key="plugin_easyssh_cmd_profiles_subtitle">profiles &lt;recherche&gt; (ou p) · vous pouvez aussi taper directement la recherche</system:String>
    <system:String x:Key="plugin_easyssh_cmd_direct_title">Se connecter sans enregistrer</system:String>
    <system:String x:Key="plugin_easyssh_cmd_direct_subtitle">d &lt;utilisateur@hôte ou commande ssh&gt;</system:String>
    <system:String x:Key="plugin_easyssh_cmd_terminal_title">Choisir le terminal</system:String>
    <system:String x:Key="plugin_easyssh_cmd_terminal_subtitle">terminal · terminal add · terminal remove</system:String>
    <system:String x:Key="plugin_easyssh_cmd_config_title">Hôtes de ~/.ssh/config</system:String>
    <system:String x:Key="plugin_easyssh_cmd_config_subtitle">config &lt;recherche&gt;</system:String>
    <system:String x:Key="plugin_easyssh_cmd_help_title">Toutes les commandes</system:String>
    <system:String x:Key="plugin_easyssh_cmd_help_subtitle">help · liste ce que sait faire EasySSH</system:String>
    <system:String x:Key="plugin_easyssh_docs_title">Ouvrir la documentation</system:String>
    <system:String x:Key="plugin_easyssh_settings_title">Ouvrir les paramètres</system:String>
    <system:String x:Key="plugin_easyssh_settings_subtitle">Gérez profils et terminaux dans Paramètres de Flow Launcher → Plugins → EasySSH</system:String>

    <!-- Ajout / suppression -->
    <system:String x:Key="plugin_easyssh_add_title">Ajouter le profil « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_update_title">Mettre à jour le profil « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_update_previous">Commande actuelle : {0}</system:String>
    <system:String x:Key="plugin_easyssh_add_missing_command">Tapez maintenant l'hôte (utilisateur@hôte) ou la commande ssh complète</system:String>
    <system:String x:Key="plugin_easyssh_remove_confirm">Supprimer le profil « {0} » ({1}) ?</system:String>

    <!-- Terminaux -->
    <system:String x:Key="plugin_easyssh_terminal_cmd">Invite de commandes</system:String>
    <system:String x:Key="plugin_easyssh_terminal_wt">Windows Terminal</system:String>
    <system:String x:Key="plugin_easyssh_terminal_powershell">Windows PowerShell</system:String>
    <system:String x:Key="plugin_easyssh_terminal_pwsh">PowerShell 7</system:String>
    <system:String x:Key="plugin_easyssh_terminal_selected">Sélectionné · {0}</system:String>
    <system:String x:Key="plugin_easyssh_terminal_not_found">Introuvable sur cet ordinateur</system:String>
    <system:String x:Key="plugin_easyssh_terminal_missing">Impossible de lancer « {0} » : {1} est introuvable. Choisissez un autre terminal avec « ssh terminal ».</system:String>
    <system:String x:Key="plugin_easyssh_terminal_add_usage_title">Ajouter un terminal personnalisé</system:String>
    <system:String x:Key="plugin_easyssh_terminal_add_usage_subtitle">terminal add &lt;nom&gt; &lt;programme&gt; [arguments, {command} pour la commande ssh]</system:String>
    <system:String x:Key="plugin_easyssh_terminal_remove_usage_title">Supprimer un terminal personnalisé</system:String>
    <system:String x:Key="plugin_easyssh_terminal_remove_usage_subtitle">terminal remove &lt;nom&gt;</system:String>
    <system:String x:Key="plugin_easyssh_terminal_add_title">Ajouter le terminal « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_terminal_update_title">Mettre à jour le terminal « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_terminal_add_not_found">Introuvable sur cet ordinateur : {0}</system:String>
    <system:String x:Key="plugin_easyssh_terminal_reserved">« {0} » est le nom d'un terminal intégré, choisissez un autre nom</system:String>
    <system:String x:Key="plugin_easyssh_terminal_none_title">Aucun terminal personnalisé</system:String>
    <system:String x:Key="plugin_easyssh_terminal_no_match_title">Aucun terminal ne correspond à « {0} »</system:String>
    <system:String x:Key="plugin_easyssh_pause_prompt">Appuyez sur Entrée pour fermer</system:String>

    <!-- ~/.ssh/config -->
    <system:String x:Key="plugin_easyssh_config_open_title">Ouvrir ~/.ssh/config</system:String>
    <system:String x:Key="plugin_easyssh_config_empty_title">Aucun hôte trouvé dans ~/.ssh/config</system:String>
    <system:String x:Key="plugin_easyssh_config_disabled_title">Les hôtes de ~/.ssh/config sont masqués</system:String>
    <system:String x:Key="plugin_easyssh_config_disabled_subtitle">Vous pouvez les réafficher dans les paramètres d'EasySSH</system:String>

    <!-- Menu contextuel -->
    <system:String x:Key="plugin_easyssh_ctx_copy">Copier la commande</system:String>
    <system:String x:Key="plugin_easyssh_ctx_edit">Modifier</system:String>
    <system:String x:Key="plugin_easyssh_ctx_edit_subtitle">Ouvre le profil dans la barre de recherche : modifiez-le et appuyez sur Entrée</system:String>
    <system:String x:Key="plugin_easyssh_ctx_remove">Supprimer</system:String>
    <system:String x:Key="plugin_easyssh_ctx_save_profile">Enregistrer comme profil</system:String>
    <system:String x:Key="plugin_easyssh_ctx_open_in">Ouvrir dans {0}</system:String>

    <!-- États et erreurs -->
    <system:String x:Key="plugin_easyssh_ssh_missing_title">Client OpenSSH introuvable</system:String>
    <system:String x:Key="plugin_easyssh_ssh_missing_subtitle">Appuyez sur Entrée pour ouvrir les fonctionnalités facultatives de Windows et ajouter « Client OpenSSH »</system:String>
    <system:String x:Key="plugin_easyssh_launch_error_title">EasySSH n'a pas pu ouvrir le terminal</system:String>
    <system:String x:Key="plugin_easyssh_save_error_title">EasySSH n'a pas pu enregistrer vos modifications</system:String>
    <system:String x:Key="plugin_easyssh_file_missing_title">Fichier introuvable</system:String>
    <system:String x:Key="plugin_easyssh_init_error_title">EasySSH n'a pas pu démarrer</system:String>
    <system:String x:Key="plugin_easyssh_init_error_subtitle">Appuyez sur Entrée pour ouvrir son dossier de données. Détails :</system:String>
    <system:String x:Key="plugin_easyssh_query_error_title">EasySSH a rencontré une erreur, voir le journal de Flow Launcher</system:String>
    <system:String x:Key="plugin_easyssh_import_done">Importé depuis {2} : {0} profil(s) et {1} terminal(aux)</system:String>
    <system:String x:Key="plugin_easyssh_data_restored">Votre fichier de profils était endommagé et a été restauré depuis sa sauvegarde. Le fichier endommagé a été conservé : {0}</system:String>
    <system:String x:Key="plugin_easyssh_data_reset">Votre fichier de profils était endommagé et aucune sauvegarde n'était disponible. Le fichier endommagé a été conservé : {0}</system:String>

    <!-- Paramètres -->
    <system:String x:Key="plugin_easyssh_settings_terminal">Terminal</system:String>
    <system:String x:Key="plugin_easyssh_settings_terminal_description">Programme qui ouvre les connexions. L'invite de commandes utilise le terminal choisi dans les paramètres de Windows.</system:String>
    <system:String x:Key="plugin_easyssh_settings_keep_open">Garder la fenêtre ouverte quand la connexion échoue, pour lire l'erreur</system:String>
    <system:String x:Key="plugin_easyssh_settings_custom_terminals">Terminaux personnalisés</system:String>
    <system:String x:Key="plugin_easyssh_settings_custom_terminals_description">Dans les arguments, {command} est remplacé par la commande ssh et {name} par le nom du profil. Sans {command}, la commande est ajoutée à la fin. Exemple, Windows Terminal avec un profil : wt.exe -p "Git Bash" {command}</system:String>
    <system:String x:Key="plugin_easyssh_settings_profiles">Profils</system:String>
    <system:String x:Key="plugin_easyssh_settings_profiles_description">Une commande qui ne commence pas par un programme (ssh, wsl, plink…) est lancée avec ssh : « admin@10.0.0.5 -p 2222 » devient « ssh admin@10.0.0.5 -p 2222 ».</system:String>
    <system:String x:Key="plugin_easyssh_settings_name">Nom</system:String>
    <system:String x:Key="plugin_easyssh_settings_program">Programme</system:String>
    <system:String x:Key="plugin_easyssh_settings_arguments">Arguments</system:String>
    <system:String x:Key="plugin_easyssh_settings_command">Commande</system:String>
    <system:String x:Key="plugin_easyssh_settings_add">Ajouter</system:String>
    <system:String x:Key="plugin_easyssh_settings_edit">Modifier</system:String>
    <system:String x:Key="plugin_easyssh_settings_delete">Supprimer</system:String>
    <system:String x:Key="plugin_easyssh_settings_save">Enregistrer</system:String>
    <system:String x:Key="plugin_easyssh_settings_cancel">Annuler</system:String>
    <system:String x:Key="plugin_easyssh_settings_browse">Parcourir…</system:String>
    <system:String x:Key="plugin_easyssh_settings_open">Ouvrir</system:String>
    <system:String x:Key="plugin_easyssh_settings_ssh_config">Configuration SSH</system:String>
    <system:String x:Key="plugin_easyssh_settings_show_config_hosts">Afficher les hôtes de ~/.ssh/config avec les profils</system:String>
    <system:String x:Key="plugin_easyssh_settings_data">Données</system:String>
    <system:String x:Key="plugin_easyssh_settings_open_folder">Ouvrir le dossier</system:String>
    <system:String x:Key="plugin_easyssh_settings_import">Importer depuis EasySSH 1.x (~/.ssh/profiles.json)</system:String>
    <system:String x:Key="plugin_easyssh_settings_error_name">Le nom est obligatoire</system:String>
    <system:String x:Key="plugin_easyssh_settings_error_command">La commande est obligatoire</system:String>
    <system:String x:Key="plugin_easyssh_settings_error_program">Le programme est obligatoire</system:String>
    <system:String x:Key="plugin_easyssh_settings_error_duplicate">« {0} » existe déjà</system:String>
    <system:String x:Key="plugin_easyssh_settings_saved">Enregistré</system:String>
    <system:String x:Key="plugin_easyssh_settings_deleted">« {0} » supprimé</system:String>
    <system:String x:Key="plugin_easyssh_settings_delete_confirm">Supprimer « {0} » ?</system:String>
    <system:String x:Key="plugin_easyssh_settings_nothing_to_import">Rien à importer : {0} n'existe pas</system:String>

</ResourceDictionary>
